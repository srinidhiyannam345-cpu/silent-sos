PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-this-with-a-long-random-secret
MONGODB_URI=mongodb://127.0.0.1:27017/silent_sos
# Admin access is restricted to this registered email (optional)
ADMIN_EMAIL=admin@example.com
# Notifications are deliberately off until you configure and test them.
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ENABLE_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Test mode logs notifications instead of delivering them.
NOTIFICATION_TEST_MODE=true
